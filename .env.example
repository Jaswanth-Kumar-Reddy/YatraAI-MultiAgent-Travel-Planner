# Environment Configuration for Multi-Agent Travel Planner
# Copy this file to .env and fill in your API keys

# LLM Configuration
# Choose your preferred LLM provider: 'openai' or 'anthropic'
LLM_PROVIDER=openai

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Anthropic Configuration (if using Anthropic Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Existing API Keys (keep these if you have them)
AMADEUS_API_KEY=your_amadeus_key_here
AMADEUS_API_SECRET=your_amadeus_secret_here

# Optional: Set to 'true' to enable debug logging
DEBUG_MODE=false
